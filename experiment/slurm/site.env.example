# Copy to experiment/slurm/site.env (git-ignored) and fill in for your cluster.
# Every script in experiment/slurm reads it.

ACCOUNT=my-account             # sbatch --account
PARTITION=batch                # sbatch --partition
PROD_CONSTRAINT="rome|turin"   # nodes for E1 E2 E4 E5 E6 (E2 needs 50 cores on one node)
E3_CONSTRAINT=rome             # one CPU model for every E3 timing run

MAIN=/path/to/psmc-rs          # the checkout with experiment/.venv and experiment/.tools
PROD=/path/to/psmc-rs-prod     # a dedicated worktree of the production commit (runs in $PROD/experiment/runs)
E3_SHARDS=/path/to/psmc-rs-e3  # one runs directory per E3 repeat, merged into $PROD afterwards
LOGS=/path/to/slurm-logs       # sbatch output files

RUST_TOOLCHAIN=1.99.0          # rustup toolchain of every build
# C psmc's CFLAGS for tools --build-c: as fast as the build allows, with the
# same output as the Makefile's -O2 (-ffp-contract=off keeps gcc from fusing
# multiply-adds); x86-64-v3 runs on every node with AVX2. Recorded in BUILD.json.
PSMC_C_CFLAGS="-g -Wall -O3 -march=x86-64-v3 -ffp-contract=off -Wno-unused-function"
PROD_CPUS=64                   # CPUs of the E1 E2 E4 E5 E6 allocation (at least 52)
PROD_MEM=200G
PROD_TIME=10:00:00
E3_TIME=24:00:00               # per repeat, on its own exclusive node (about 5-9 h of runs)
