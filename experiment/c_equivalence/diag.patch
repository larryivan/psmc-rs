+
+// DIAG: C psmc's M-step (em.c's psmc_em and func, kmin.c's kmin_hj), on
+// psmc-rs's objective. KMIN_RADIUS, KMIN_EPS and KMIN_MAXCALL of kmin.h.
+const KMIN_RADIUS: f64 = 0.5;
+const KMIN_EPS: f64 = 1e-7;
+const KMIN_MAXCALL: usize = 50000;
+
+/// C's M-step: `kmin_hj(func, n_params, params, .., KMIN_RADIUS, KMIN_EPS,
+/// KMIN_MAXCALL)` from the current parameters, where `func` sets the
+/// model's parameters to the absolute values of its argument and returns
+/// minus Q there. C keeps the parameters `func` set last (it frees the
+/// search's own best point), so the result is the last point evaluated.
+/// Like C, no bounds and no row-sum test (C's `hmm_Q` rejects only
+/// probabilities <= 0).
+fn hooke_jeeves_m_step(objective: &mut Objective<'_>, start: Vec<f64>) -> MStepOutcome {
+    objective.set_row_tolerance(f64::INFINITY);
+    let trace = std::env::var("PSMC_DIAG_HJ_TRACE").is_ok_and(|v| v == "1");
+    let mut last = start.clone();
+    let mut cnt = 0usize;
+    let mut func = |x: &[f64]| -> f64 {
+        for (l, v) in last.iter_mut().zip(x) {
+            *l = v.abs();
+        }
+        let f = objective.value_at_params(&last);
+        cnt += 1;
+        if trace {
+            let p: Vec<String> = last.iter().map(|v| format!("{v:?}")).collect();
+            eprintln!("HJ\t{cnt}\t{f:?}\t{}", p.join("\t"));
+        }
+        f
+    };
+    let mut x = start;
+    let (_, n_calls, outer) = kmin_hj(&mut func, &mut x, KMIN_RADIUS, KMIN_EPS, KMIN_MAXCALL);
+    MStepOutcome {
+        params: last,
+        evaluations: n_calls,
+        iterations: outer,
+        stop: if n_calls >= KMIN_MAXCALL {
+            MStepStop::MaxIters
+        } else {
+            MStepStop::Converged
+        },
+    }
+}
+
+/// kmin.c's `__kmin_hj_aux`: one exploratory move from `x1` along each
+/// coordinate; returns the value at the new `x1`.
+fn kmin_hj_aux(
+    func: &mut impl FnMut(&[f64]) -> f64,
+    x1: &mut [f64],
+    mut fx1: f64,
+    dx: &mut [f64],
+    n_calls: &mut usize,
+) -> f64 {
+    let n = x1.len();
+    let mut j = *n_calls;
+    for k in 0..n {
+        x1[k] += dx[k];
+        let ftmp = func(x1);
+        j += 1;
+        if ftmp < fx1 {
+            fx1 = ftmp;
+        } else {
+            // search the opposite direction
+            dx[k] = 0.0 - dx[k];
+            x1[k] += dx[k] + dx[k];
+            let ftmp = func(x1);
+            j += 1;
+            if ftmp < fx1 {
+                fx1 = ftmp;
+            } else {
+                x1[k] -= dx[k]; // back to the original x[k]
+            }
+        }
+    }
+    *n_calls = j;
+    fx1
+}
+
+/// kmin.c's `kmin_hj`, statement for statement: returns its return value
+/// (`fx1`), the number of calls of `func`, and the passes of its outer loop.
+fn kmin_hj(
+    func: &mut impl FnMut(&[f64]) -> f64,
+    x: &mut [f64],
+    r: f64,
+    eps: f64,
+    max_calls: usize,
+) -> (f64, usize, usize) {
+    let n = x.len();
+    let mut n_calls = 0usize;
+    let mut x1 = vec![0.0; n];
+    let mut dx = vec![0.0; n];
+    for k in 0..n {
+        // initial directions, based on MGJ
+        dx[k] = x[k].abs() * r;
+        if dx[k] == 0.0 {
+            dx[k] = r;
+        }
+    }
+    let mut radius = r;
+    let mut fx = func(x);
+    n_calls += 1;
+    let mut fx1;
+    let mut outer = 0usize;
+    loop {
+        outer += 1;
+        x1.copy_from_slice(x); // x1 = x
+        fx1 = kmin_hj_aux(func, &mut x1, fx, &mut dx, &mut n_calls);
+        while fx1 < fx {
+            for k in 0..n {
+                let t = x[k];
+                dx[k] = if x1[k] > x[k] { dx[k].abs() } else { 0.0 - dx[k].abs() };
+                x[k] = x1[k];
+                x1[k] = x1[k] + x1[k] - t;
+            }
+            fx = fx1;
+            if n_calls >= max_calls {
+                break;
+            }
+            fx1 = func(&x1);
+            n_calls += 1;
+            fx1 = kmin_hj_aux(func, &mut x1, fx1, &mut dx, &mut n_calls);
+            if fx1 >= fx {
+                break;
+            }
+            let mut k = 0;
+            while k != n {
+                if (x1[k] - x[k]).abs() > 0.5 * dx[k].abs() {
+                    break;
+                }
+                k += 1;
+            }
+            if k == n {
+                break;
+            }
+        }
+        if radius >= eps {
+            if n_calls >= max_calls {
+                break;
+            }
+            radius *= r;
+            for d in dx.iter_mut() {
+                *d *= r;
+            }
+        } else {
+            break; // converge
+        }
+    }
+    (fx1, n_calls, outer)
 }
 
