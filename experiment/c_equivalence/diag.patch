+//! SCRATCH DIAGNOSTIC TOGGLES (never committed; not part of any release).
+//!
+//! Each is read once from the environment; with none set the program is
+//! src dcf29ca's, output for output.
+//!
+//! - `PSMC_DIAG_LASTBIN=1`: each sequence's last bin is left out of the
+//!   E-step's expected emission counts, as C psmc's `hmm_expect` leaves it
+//!   out (its loop over `u = 1 .. L-1` adds `E` for bins 1 to L-1; its
+//!   transitions `A` cover every pair of neighbouring bins, so they are
+//!   unchanged).
+//! - `PSMC_DIAG_HJ=1`: the M-step is a port of C psmc's `kmin_hj`
+//!   (kmin.c) driven as its `psmc_em` (em.c) drives it, on psmc-rs's
+//!   objective in the natural parameters, instead of L-BFGS.
+//! - `PSMC_DIAG_REL_TOL=x`: the CLI's M-step runs with `rel_tol` x.
+
+use std::sync::OnceLock;
+
+fn flag(name: &str) -> bool {
+    std::env::var(name).is_ok_and(|v| v == "1")
+}
+
+/// `PSMC_DIAG_LASTBIN=1`.
+pub fn lastbin() -> bool {
+    static V: OnceLock<bool> = OnceLock::new();
+    *V.get_or_init(|| flag("PSMC_DIAG_LASTBIN"))
+}
+
+/// `PSMC_DIAG_HJ=1`.
+pub fn hj() -> bool {
+    static V: OnceLock<bool> = OnceLock::new();
+    *V.get_or_init(|| flag("PSMC_DIAG_HJ"))
+}
+
+/// `PSMC_DIAG_REL_TOL`, when set.
+pub fn rel_tol() -> Option<f64> {
+    static V: OnceLock<Option<f64>> = OnceLock::new();
+    *V.get_or_init(|| {
+        std::env::var("PSMC_DIAG_REL_TOL")
+            .ok()
+            .map(|v| v.parse().expect("PSMC_DIAG_REL_TOL must be a number"))
+    })
+}
