+    /// DIAG (Hooke-Jeeves port): the objective at the parameters `p`
+    /// themselves (θ, ρ, t_max, then the free λ), not at logit
+    /// coordinates, and without its gradient. `+inf` where [`Self::eval`]
+    /// gives `+inf`.
+    pub(crate) fn value_at_params(&mut self, p: &[f64]) -> f64 {
+        self.evaluations += 1;
+        assert!(p.len() == self.bounds.len(), "{} parameters for {} bounds", p.len(), self.bounds.len());
+        self.ws.p.copy_from_slice(p);
+        for (l, &g) in self.ws.lam.iter_mut().zip(&self.group) {
+            *l = p[3 + g];
+        }
+        let (theta, rho, t_max) = (p[0], p[1], p[2]);
+        self.ws.shared.update(&self.ws.lam, rho, t_max);
+        let rows = self.rows(theta, rho);
+        self.row_deviation = if rows.valid {
+            rows.row_deviation
+        } else {
+            f64::NAN
+        };
+        if !rows.valid || rows.row_deviation > self.row_tolerance || !rows.q.is_finite() {
+            return f64::INFINITY;
+        }
+        if self.lambda == 0.0 {
+            return -rows.q;
+        }
+        let lam = &self.ws.lam;
+        let penalty: f64 = (0..self.n)
+            .map(|k| {
+                let d = lam[k + 1].ln() - lam[k].ln();
+                d * d
+            })
+            .sum();
+        -rows.q + penalty * self.lambda
+    }
